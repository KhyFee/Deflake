{
  "name": "@khyfee/deflake",
  "version": "0.1.0",
  "description": "Flaky Test Auto-Triager \u2014 parallel Playwright attempts + statistical + AI triage",
  "type": "module",
  "bin": {
    "deflake": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "demo": "tsx src/cli.ts demo",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@khyfee/deflake-core": "0.1.0",
    "@khyfee/deflake-reporters": "0.1.0"
  },
  "author": "KhyFee (https://github.com/KhyFee)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asyncapps-hq/Deflake.git"
  },
  "homepage": "https://github.com/asyncapps-hq/Deflake#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "playwright",
    "flake",
    "flaky",
    "qa",
    "ci",
    "deflake"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bugs": {
    "url": "https://github.com/asyncapps-hq/Deflake/issues"
  }
}
